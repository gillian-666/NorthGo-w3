{
  "name": "northgo-web",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pages": "node scripts/build-github-pages.mjs",
    "start": "next start",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply northgo-enquiries --local",
    "db:migrate:remote": "wrangler d1 migrations apply northgo-enquiries --remote"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "@sanity/client": "^8.15.1",
    "@sanity/image-url": "^2.1.1",
    "leaflet": "^1.9.4",
    "next": "16.4.6",
    "next-intl": "^4.15.0",
    "next-sanity": "^13.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.38.0",
    "sanity": "^6.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261118.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "wrangler": "^4.164.0"
  }
}
