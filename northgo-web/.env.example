NEXT_PUBLIC_SITE_URL=https://www.northgo.com

# Resend (enquiry form). Without RESEND_API_KEY, submissions are logged server-side.
RESEND_API_KEY=
ENQUIRE_TO_EMAIL=info.tpe@northgo.com
ENQUIRE_FROM_EMAIL=Northgo Website <onboarding@resend.dev>

# Admin console (/admin/login) — required for backend management UI
# ADMIN_USERNAME / ADMIN_PASSWORD seed the first owner account (multi-user CRUD thereafter).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# Sanity CMS (optional until project is created)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=

# Analytics (optional)
NEXT_PUBLIC_GA_ID=
